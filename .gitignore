node_modules/
dist/
data/
inbox/*
!inbox/.gitkeep
repos.json
.env
*.log
.DS_Store
tsconfig.tsbuildinfo

# Scratch probes written into the repo root while working — browser
# walkthroughs, throwaway packs, one-off queries. Never part of the build; the
# real scripts live in server/scripts/. Six of them reached a commit through
# `git add -A` before this rule existed, and two more when it only covered the
# dot-prefixed ones.
/*.mjs
/.probe-*.json

# The live team registry is per deployment; the template is teams.example.json
# and the demo fixture is demo/teams.json. Anchored, so demo/teams.json — which
# IS committed, and is what the verification runs against — is not swept up.
/teams.json
