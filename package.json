{
  "name": "architecture-map",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first map of a service estate, built from evidence-carrying scan manifests",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "validate": "node server/scripts/validate.mjs",
    "seed:demo": "node server/scripts/seed-demo.mjs",
    "verify": "node server/scripts/verify.mjs",
    "verify:ui": "node server/scripts/verify-ui.mjs",
    "verify:dev": "node server/scripts/verify-dev.mjs",
    "prompts": "node server/scripts/build-prompts.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.49.1"
  },
  "engines": {
    "node": ">=20.11"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true
  }
}
