{
  "schemaVersion": 1,
  "promptVersion": "2026-09-18b",
  "pack": "reporting",
  "name": "Reporting",
  "authoredAt": "2026-09-16T09:45:00Z",
  "producer": {
    "kind": "import",
    "tool": "seed-demo/1"
  },
  "source": {
    "kind": "confluence",
    "url": "https://meridian.atlassian.net/wiki/spaces/DATA/pages/311/Reporting",
    "title": "Reporting — how the warehouse is built",
    "owner": "data",
    "asOf": "2025-11-03"
  },
  "processes": [
    {
      "code": "3",
      "name": "Reporting",
      "owner": "data"
    },
    {
      "code": "3.1",
      "name": "Building the read models",
      "owner": "data"
    },
    {
      "code": "3.1.1",
      "name": "Enrich matched trades",
      "owner": "data",
      "node": "svc:reporting-service",
      "interaction": {
        "from": "svc:reporting-service",
        "kind": "kafka.consume",
        "to": "topic:trades.enriched.v1"
      }
    },
    {
      "code": "3.1.2",
      "name": "Ingest matched trades",
      "owner": "data",
      "node": "svc:reporting-service",
      "interaction": {
        "from": "svc:reporting-service",
        "kind": "kafka.consume",
        "to": "topic:orders.matched.v1"
      }
    },
    {
      "code": "3.1.3",
      "name": "Ingest balance changes",
      "owner": "data",
      "node": "svc:reporting-service",
      "interaction": {
        "from": "svc:reporting-service",
        "kind": "kafka.consume",
        "to": "topic:wallet.balance.changed.v1"
      }
    },
    {
      "code": "3.1.4",
      "name": "Write the warehouse",
      "owner": "data",
      "node": "svc:reporting-service",
      "interaction": {
        "from": "svc:reporting-service",
        "kind": "db.write",
        "to": "db:postgres/reporting"
      }
    },
    {
      "code": "3.1.5",
      "name": "Reconcile against the ledger",
      "owner": "data",
      "node": "svc:reporting-service",
      "interaction": {
        "from": "svc:reporting-service",
        "kind": "db.read",
        "to": "db:postgres/ledger"
      }
    },
    {
      "code": "3.2",
      "name": "Serving reports",
      "owner": "data"
    },
    {
      "code": "3.2.1",
      "name": "Index the report",
      "owner": "data",
      "node": "svc:reporting-service",
      "interaction": {
        "from": "svc:reporting-service",
        "kind": "db.write",
        "to": "db:elasticsearch/search"
      }
    },
    {
      "code": "3.2.2",
      "name": "Answer a report request",
      "owner": "data",
      "node": "svc:gateway-api",
      "interaction": {
        "from": "svc:gateway-api",
        "kind": "http.call",
        "to": "api:reporting-service/GET /v1/reports/{}"
      }
    },
    {
      "code": "3.2.3",
      "name": "Look up live balances for the statement",
      "owner": "data",
      "node": "svc:reporting-service",
      "interaction": {
        "from": "svc:reporting-service",
        "kind": "http.call",
        "to": "api:wallet-service/GET /v1/wallets/{}/balance"
      }
    }
  ]
}
