{
  "schemaVersion": 1,
  "promptVersion": "2026-09-18b",
  "pack": "onboarding",
  "name": "Onboarding and funding",
  "authoredAt": "2026-09-17T15:30:00Z",
  "producer": {
    "kind": "import",
    "tool": "seed-demo/1"
  },
  "source": {
    "kind": "confluence",
    "url": "https://meridian.atlassian.net/wiki/spaces/ID/pages/204/Onboarding+and+funding",
    "title": "Onboarding and funding — process map",
    "owner": "identity",
    "asOf": "2026-08-14"
  },
  "processes": [
    {
      "code": "1",
      "name": "Onboarding and funding",
      "owner": "identity"
    },
    {
      "code": "1.1",
      "name": "Opening an account",
      "owner": "identity"
    },
    {
      "code": "1.1.1",
      "name": "Create the customer record",
      "owner": "identity",
      "node": "svc:identity-service",
      "interaction": {
        "from": "svc:identity-service",
        "kind": "db.write",
        "to": "db:postgres/identity"
      }
    },
    {
      "code": "1.1.2",
      "name": "Announce the new customer",
      "owner": "identity",
      "node": "svc:identity-service",
      "interaction": {
        "from": "svc:identity-service",
        "kind": "kafka.produce",
        "to": "topic:users.created.v2"
      }
    },
    {
      "code": "1.1.3",
      "name": "Open the wallets",
      "owner": "identity",
      "node": "svc:wallet-service",
      "interaction": {
        "from": "svc:wallet-service",
        "kind": "db.write",
        "to": "db:postgres/wallet"
      },
      "touches": [
        "topic:users.created.v2"
      ]
    },
    {
      "code": "1.1.4",
      "name": "Start the session",
      "owner": "identity",
      "node": "svc:gateway-api",
      "interaction": {
        "from": "svc:gateway-api",
        "kind": "cache.write",
        "to": "cache:redis/session"
      }
    },
    {
      "code": "1.2",
      "name": "Verifying identity",
      "owner": "identity"
    },
    {
      "code": "1.2.1",
      "name": "Record the verification result",
      "owner": "identity",
      "node": "svc:identity-service",
      "interaction": {
        "from": "svc:identity-service",
        "kind": "db.write",
        "to": "db:postgres/identity"
      }
    },
    {
      "code": "1.2.2",
      "name": "Announce approval",
      "owner": "identity",
      "node": "svc:identity-service",
      "interaction": {
        "from": "svc:identity-service",
        "kind": "kafka.produce",
        "to": "topic:kyc.approved.v1"
      }
    },
    {
      "code": "1.2.3",
      "name": "Enable trading on the wallet",
      "owner": "identity",
      "node": "svc:wallet-service",
      "interaction": {
        "from": "svc:wallet-service",
        "kind": "kafka.consume",
        "to": "topic:kyc.approved.v1"
      }
    },
    {
      "code": "1.3",
      "name": "Funding the account",
      "owner": "identity"
    },
    {
      "code": "1.3.1",
      "name": "Take the card payment",
      "owner": "identity",
      "node": "svc:payments-service",
      "interaction": {
        "from": "svc:payments-service",
        "kind": "http.call",
        "to": "ext:stripe"
      }
    },
    {
      "code": "1.3.2",
      "name": "Record the payment",
      "owner": "identity",
      "node": "svc:payments-service",
      "interaction": {
        "from": "svc:payments-service",
        "kind": "db.write",
        "to": "db:postgres/payments"
      }
    },
    {
      "code": "1.3.3",
      "name": "Announce the settled payment",
      "owner": "identity",
      "node": "svc:payments-service",
      "interaction": {
        "from": "svc:payments-service",
        "kind": "kafka.produce",
        "to": "topic:payments.settled.v1"
      }
    },
    {
      "code": "1.3.4",
      "name": "Post the deposit to the ledger",
      "owner": "identity",
      "node": "svc:ledger-service",
      "interaction": {
        "from": "svc:ledger-service",
        "kind": "kafka.consume",
        "to": "topic:payments.settled.v1"
      },
      "touches": [
        "db:postgres/ledger"
      ]
    }
  ]
}
